<?xml version="1.0" encoding="utf-8"?>
<!--
    3×1 по умолчанию; растягивается вниз — видны расходы и счета.
    Обновление — приложение после каждой записи в базу; раз в 3 часа — для смены месяца.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_balance"
    android:previewLayout="@layout/widget_balance"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:widgetCategory="home_screen" />
